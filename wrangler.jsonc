{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "1010group",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "keep_vars": true
}
